{
  "manifest_version": 3,
  "name": "Spotamp — Winamp for Spotify",
  "short_name": "Spotamp",
  "version": "0.1.0",
  "description": "A classic Winamp 2-era interface for the Spotify Web Player, powered by Webamp.",
  "minimum_chrome_version": "114",
  "permissions": ["storage"],
  "host_permissions": ["https://open.spotify.com/*"],
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Spotamp",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
