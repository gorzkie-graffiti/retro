{
  "name": "spotamp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Winamp-inspired browser extension for the Spotify Web Player",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "package": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/chrome": "^0.1.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.9.1",
    "esbuild": "^0.25.11",
    "eslint": "^9.38.0",
    "globals": "^16.5.0",
    "jsdom": "^27.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^3.2.4"
  }
}
