# Copy this file to .env and fill in what you need.
# start.sh loads .env automatically; the file must contain plain KEY=value lines.
# .env is git-ignored. Never commit real keys.

# Google AI Studio / Gemini API key. Required only for:
#   ./start.sh --use api
# Create one at https://aistudio.google.com/apikey
# The dev server proxies requests and adds this key server-side, so it is not
# placed in the browser bundle or in localStorage.
GEMINI_API_KEY=

# Where gemini-web2api listens (bridge mode only). start.sh checks this address
# and starts a local copy when nothing is listening.
BRIDGE_URL=http://127.0.0.1:8081/v1
